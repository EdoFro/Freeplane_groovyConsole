.gradle
**/build/
!src/**/build/
.idea
# Machine-local build library path; keep the example in version control.
/groovyConsole/gradle.properties

# Ignore Gradle GUI config
gradle-app.setting

# Cache of project
.gradletasknamecache

# # Work around https://youtrack.jetbrains.com/issue/IDEA-116898
# gradle/wrapper/gradle-wrapper.properties

# Addon maps
*.addon.mm
*.mm.bak
/GroovyConsole project.mm
# version.properties

# ignore .jar files
*.jar
# Keep the Gradle Wrapper bootstrap JAR; this exception must follow *.jar.
!groovyConsole/gradle/wrapper/gradle-wrapper.jar

# ignore some folders
ignoredByGitHub/
delete/
